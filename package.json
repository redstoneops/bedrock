{
	"name": "bedrock-monorepo",
	"private": true,
	"type": "module",
	"description": "Bedrock: agents that stand on verified ground. A terminal coding-agent harness for extremely hard, long-horizon tasks.",
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "biome check . && tsc --noEmit -p tsconfig.json",
		"fix": "biome check --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"build": "node scripts/build.mjs",
		"bedrock": "node --conditions=bedrock-source --disable-warning=ExperimentalWarning packages/cli/src/main.ts",
		"refs": "scripts/fetch-refs.sh",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"husky": "9.1.7",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
