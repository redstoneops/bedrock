{
	"name": "@bedrock/tui",
	"version": "0.1.0",
	"description": "Mission Control terminal UI on pi-tui.",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"bedrock-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
